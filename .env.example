# İletişim formu (Vercel > Settings > Environment Variables). Bu dosya örnektir; gerçek değerler git'e girmez.
# Resend hesabı açıp API anahtarı al: https://resend.com (ücretsiz katman yeter).
RESEND_API_KEY=
# Mesajların düşeceği adres. Alan adı doğrulamadan yalnız Resend hesabının e-postasına gönderilebilir.
CONTACT_TO=
# İsteğe bağlı: alan adı doğrulandıysa kendi adresin, örn. "Site <site@alanadin.com>"
# CONTACT_FROM=
# İsteğe bağlı: sitenin adresi (OpenGraph ve sitemap için). Vercel adresi varsayılan.
# NEXT_PUBLIC_SITE_URL=https://cansinyrkl.vercel.app
